# Copy this to .env.local for local work. Never commit a real value.
# On Render, DATABASE_URL and SESSION_SECRET are set for you (see render.yaml),
# and you set ADMIN_PASSCODE and ANTHROPIC_API_KEY in the Render dashboard.

# Postgres connection. On Render this comes from the managed database.
DATABASE_URL=postgresql://user:password@localhost:5432/dz_field_app

# Signs the admin session cookie. On Render this is generated automatically.
SESSION_SECRET=change-me-to-a-long-random-string

# Passcode for the /admin captures view. Leave unset to keep /admin closed.
ADMIN_PASSCODE=

# Claude API key for the sorter. Leave unset to keep the sort test closed.
ANTHROPIC_API_KEY=

# Optional: which Claude model the sorter uses. Defaults to claude-haiku-5-5.
ANTHROPIC_MODEL=
